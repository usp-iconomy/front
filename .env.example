# Auth.js — generate with `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=
# Public origin of this app: `next start` requires it, and sign-out uses it for the post-logout redirect
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/iconomy
AUTH_KEYCLOAK_ID=iconomy-web
# usp-iconomy/api — `make dev` in that repo
API_URL=http://localhost:8000
